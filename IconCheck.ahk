; 왼쪽에 가끔 뜨는 문파 도움 아이콘(주황 바탕 흰 주먹 그림)을 찾는다. (자동스페이스.ahk 에서 #Include, AutoCheck.ahk 가 먼저 있어야 한다)
; 기준 화면(클라이언트 1318x741)에서 아이콘 중심은 왼쪽 아래 모서리에서 (32, 155) 떨어져 있다.
; 주황 테두리는 바닥 흙색과 비슷해서 믿기 어렵다. 그래서 흰 그림 모양만 맞춰 본다.

ICON_FROM_LEFT := 32, ICON_FROM_BOTTOM := 155
ICON_RING := 18    ; 그림 틀과 1~2픽셀 어긋남까지 덮는 반지름 (기준 화면 픽셀)

; 흰 그림 모양 (기준 화면 픽셀, 아이콘 중심 = 틀 가운데)
; # = 흰 그림이어야 하는 곳, . = 흰색이 아니어야 하는 곳, 공백 = 안 봄
ICON_SHAPE := [
    "..........................."
  , "..........................."
  , "..........................."
  , "........#####.######......."
  , "......# #############......"
  , ".... .##############..#...."
  , "....#..#############......."
  , ".... #.########..##........"
  , ".... #.####### .....#.. ..."
  , "...#.#.       ..##.##.#...."
  , "...#.########. #.#######..."
  , "...#..........###..## ##..."
  , ".. #########..#... #### ..."
  , "... #######..# #. ######..."
  , ".............##.####### ..."
  , ".....######....########...."
  , ".....## ##  .#########.#..."
  , ".....##.......##### ..##..."
  , "...............###.. ##...."
  , ".....................#....."
  , "..........................."
  , "..........................."
  , "..........................."
]

; 클라이언트 크기(w, h)에서 아이콘 중심이 있을 만한 곳 목록 [{x, y, s}] (AutoCandidates 와 같은 세 배율)
IconCandidates(w, h) {
    sH := h / AUTO_REF_H, sW := w / AUTO_REF_W
    list := []
    for s in [sH, sW, Sqrt(sH * sW)] {
        dup := false
        for c in list
            if Abs(c.s - s) < 0.02
                dup := true
        if !dup
            list.Push({x: Round(ICON_FROM_LEFT * s), y: Round(h - ICON_FROM_BOTTOM * s), s: s})
    }
    return list
}

; 아이콘이 떠 있으면 누를 곳 {x, y} (클라이언트 좌표), 없으면 ""
; 게임 창이 최소화됐거나 가려져서 못 보면 "minimized" / "hidden"
FindIcon(hwnd) {
    cap := CaptureAround(hwnd, IconCandidates, ICON_RING)
    if !IsObject(cap)
        return cap
    for c in cap.cands
        if MatchShape(cap.img, c.x, c.y, c.s, ICON_SHAPE, (px) => !IsLight(px))
            return {x: c.x, y: c.y}
    return ""
}
